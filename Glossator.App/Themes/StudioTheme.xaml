    <SolidColorBrush x:Key="StudioAccentSoftBrush" Color="#1F3B82F6"/>
    <SolidColorBrush x:Key="StudioSuccessSoftBrush" Color="#1F10B981"/>
    <SolidColorBrush x:Key="StudioWarningSoftBrush" Color="#1FF59E0B"/>
    <SolidColorBrush x:Key="StudioTerminalBrush" Color="#0D0F14"/>
    <SolidColorBrush x:Key="DataGridAlternatingRowBrush" Color="#07FFFFFF"/>
    <SolidColorBrush x:Key="DataGridGridLineBrush" Color="#16FFFFFF"/>
    <SolidColorBrush x:Key="StudioAccentForegroundBrush" Color="#60A5FA"/>
    <SolidColorBrush x:Key="StudioOnAccentSoftTextBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="StudioSidebarTextBrush" Color="#CBD5E1"/>
    <SolidColorBrush x:Key="StudioMutedTextBrush" Color="#94A3B8"/>

