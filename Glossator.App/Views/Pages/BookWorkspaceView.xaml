<UserControl x:Class="Glossator.App.Views.Pages.BookWorkspaceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:controls="clr-namespace:Glossator.App.Views.Controls"
             xmlns:vm="clr-namespace:Glossator.App.ViewModels">
    <Grid Margin="24,18,24,16">
        <!-- Kitap Açılmamışsa Boş Durum -->
        <Border Background="{DynamicResource StudioCardBrush}"
                BorderBrush="{DynamicResource StudioBorderBrush}"
                BorderThickness="1"
                CornerRadius="12"
                Padding="36"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                MaxWidth="500"
                Visibility="{Binding HasActiveBook, Converter={StaticResource InverseBoolToVisConverter}}">
            <StackPanel HorizontalAlignment="Center">
                <ui:SymbolIcon Symbol="BookOpen24" FontSize="42" Foreground="{DynamicResource StudioAccentBrush}" HorizontalAlignment="Center"/>
                <TextBlock Text="Aktif Kitap Seçilmedi"
                           FontSize="17"
                           FontWeight="SemiBold"
                           Margin="0,12,0,6"
                           HorizontalAlignment="Center"/>
                <TextBlock Text="Bir EPUB açın, sol menüdeki Son Kitaplar'dan seçin veya pencereye .epub dosyasını bırakın."
                           FontSize="12.5"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           Margin="0,0,0,18"/>
                <ui:Button Content="EPUB Kitabı Seç"
                           Icon="{ui:SymbolIcon DocumentAdd24}"
                           Appearance="Primary"
                           HorizontalAlignment="Center"
                           Command="{Binding OpenEpubFileCommand}"/>
            </StackPanel>
        </Border>

        <!-- Aktif Kitap Çalışma Masası -->
        <Grid Visibility="{Binding HasActiveBook, Converter={StaticResource BoolToVisConverter}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 1. Kompakt Kitap Başlık Kartı -->
            <Border Grid.Row="0"
                    Background="{DynamicResource StudioCardBrush}"
                    BorderBrush="{DynamicResource StudioBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="16"
                    Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="68"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <controls:BookCoverControl Grid.Column="0"
                                               Width="68" Height="94"
                                               VerticalAlignment="Center"
                                               CoverPath="{Binding CoverImagePath}"
                                               Monogram="{Binding CoverFallbackMonogram}"
                                               FallbackHex="{Binding CoverFallbackHex}"
                                               CoverCornerRadius="6"
                                               MonogramFontSize="22"/>

                    <StackPanel Grid.Column="1" Margin="16,0,16,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding BookTitle}"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding BookTitle}"/>

                        <StackPanel Orientation="Horizontal" Margin="0,4,0,8">
                            <TextBlock Text="{Binding BookAuthor}"
                                       FontSize="12.5"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                            <Border Background="{DynamicResource StudioCardElevatedBrush}"
                                    BorderBrush="{DynamicResource StudioBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    Padding="7,1"
                                    Margin="10,0,0,0"
                                    Visibility="{Binding BookPublisher, Converter={StaticResource HasValueToVisConverter}}">
                                <TextBlock Text="{Binding BookPublisher}" FontSize="11"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                            </Border>
                        </StackPanel>

                        <Grid MaxWidth="420" HorizontalAlignment="Left" Width="380" Margin="0,0,0,6">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="{Binding BookProgressText}"
                                       FontSize="11.5"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       Margin="0,0,0,4"/>
                            <ProgressBar Grid.Row="1"
                                         Value="{Binding BookProgressPercentage, Mode=OneWay}"
                                         Maximum="100"
                                         Height="5"/>
                        </Grid>

                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                            <ui:Button Content="OPF Klasörünü Aç"
                                       Icon="{ui:SymbolIcon FolderOpen24}"
                                       Appearance="Transparent"
                                       Padding="8,3"
                                       FontSize="11.5"
                                       Command="{Binding OpenOpfDirectoryCommand}"/>
                            <ui:Button Content="Bu kitaptan terim tara →"
                                       Icon="{ui:SymbolIcon BookSearch24}"
                                       Appearance="Transparent"
                                       Padding="8,3"
                                       Margin="8,0,0,0"
                                       FontSize="11.5"
                                       Foreground="{DynamicResource StudioAccentBrush}"
                                       Command="{Binding ScanBookGlossaryCommand}"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Sağ Aksiyon Grubu -->
                    <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                        <ui:Button Content="Seçili Bölümleri Çevir"
                                   Icon="{ui:SymbolIcon Play24}"
                                   Appearance="Primary"
                                   Padding="16,8"
                                   Command="{Binding TranslateSelectedCommand}"/>

                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0" HorizontalAlignment="Right">
                            <ui:Button Content="EPUB Paketle"
                                       Icon="{ui:SymbolIcon Box24}"
                                       Appearance="Secondary"
                                       Padding="11,6"
                                       Command="{Binding PackageEpubCommand}"
                                       Margin="0,0,8,0"/>

                            <ToggleButton Style="{StaticResource ToolbarToggleStyle}"
                                          IsChecked="{Binding IsEngineOptionsExpanded, Mode=TwoWay}"
                                          ToolTip="Eşzamanlı işçi sayısı, Test modu ve Checkpoint ayarlarını aç/kapat">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="Settings24" FontSize="14" Margin="0,0,6,0"/>
                                    <TextBlock Text="Motor Ayarları" FontSize="12"/>
                                </StackPanel>
                            </ToggleButton>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 2. Açılır-Kapanır Motor Ayarları Paneli -->
            <Border Grid.Row="1"
                    Background="{DynamicResource StudioCardElevatedBrush}"
                    BorderBrush="{DynamicResource StudioBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="14,10"
                    Margin="0,0,0,12"
                    Visibility="{Binding IsEngineOptionsExpanded, Converter={StaticResource BoolToVisConverter}}">
                <Grid IsEnabled="{Binding IsLocked, Converter={StaticResource InverseBoolConverter}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,20,0">
                        <TextBlock Text="Eşzamanlı İşçi:" VerticalAlignment="Center" Margin="0,0,8,0"
                                   FontSize="12.5" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        <ui:NumberBox Value="{Binding WorkersCount, Mode=TwoWay}"
                                      Minimum="1" Maximum="8"
                                      SpinButtonPlacementMode="Inline"
                                      MaxDecimalPlaces="0"
                                      Width="112"/>
                    </StackPanel>

                    <CheckBox Grid.Column="1"
                              Content="Sıfırdan Çevir (Fresh)"
                              IsChecked="{Binding IsFreshMode, Mode=TwoWay}"
                              VerticalAlignment="Center"
                              Margin="0,0,18,0"
                              ToolTip="Bölümün eski SQLite checkpoint ve .done/.part dosyalarını yoksayıp baştan çevirir"/>

                    <CheckBox Grid.Column="2"
                              Content="Test Modu (İlk 2 Kesit)"
                              IsChecked="{Binding IsTestMode, Mode=TwoWay}"
                              VerticalAlignment="Center"
                              Margin="0,0,18,0"
                              ToolTip="Her bölümden yalnızca ilk 2 mantıksal kesiti çevirir ve .part olarak kaydeder"/>

                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Kesit Limiti:" VerticalAlignment="Center" Margin="0,0,8,0"
                                   FontSize="12.5" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        <ui:TextBox Text="{Binding SectionLimitText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    PlaceholderText="Tümü"
                                    Width="78"/>
                    </StackPanel>

                    <ui:Button Grid.Column="5"
                               Content="Seçili Önbelleği Sıfırla"
                               Icon="{ui:SymbolIcon ArrowReset24}"
                               Appearance="Secondary"
                               Padding="10,5"
                               FontSize="12"
                               Command="{Binding ResetSelectedCheckpointsCommand}"
                               ToolTip="İşaretli bölümlerin SQLite checkpoint önbelleğini ve çıktı dosyalarını temizler"/>
                </Grid>
            </Border>

            <!-- 3. Filtre Pill'leri, Arama ve Aralık Seçimi -->
            <Border Grid.Row="2"
                    Background="{DynamicResource StudioCardBrush}"
                    BorderBrush="{DynamicResource StudioBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="12,9"
                    Margin="0,0,0,10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="8"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Üst Satır: Pill Filtreler + Arama -->
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <RadioButton Style="{StaticResource FilterPillRadioStyle}"
                                         GroupName="ChapterFilterGroup"
                                         Content="Tümü"
                                         IsChecked="{Binding SelectedChapterFilter, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=All}"/>
                            <RadioButton Style="{StaticResource FilterPillRadioStyle}"
                                         GroupName="ChapterFilterGroup"
                                         Content="Çevrilmemiş"
                                         IsChecked="{Binding SelectedChapterFilter, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=Untranslated}"/>
                            <RadioButton Style="{StaticResource FilterPillRadioStyle}"
                                         GroupName="ChapterFilterGroup"
                                         Content="Tamamlanan"
                                         IsChecked="{Binding SelectedChapterFilter, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=Completed}"/>
                            <RadioButton Style="{StaticResource FilterPillRadioStyle}"
                                         GroupName="ChapterFilterGroup"
                                         Content="Sadece Bölümler"
                                         IsChecked="{Binding SelectedChapterFilter, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=ChaptersOnly}"/>
                        </StackPanel>

                        <ui:TextBox Grid.Column="1"
                                    Margin="12,0,10,0"
                                    PlaceholderText="Bölüm başlığı veya dosya adıyla filtrele..."
                                    Icon="{ui:SymbolIcon Search24}"
                                    Text="{Binding ChapterSearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                        <ui:Button Grid.Column="2"
                                   Content="Filtreyi Sıfırla"
                                   Appearance="Transparent"
                                   Padding="10,5"
                                   Command="{Binding ResetChapterFiltersCommand}"/>
                    </Grid>

                    <!-- Alt Satır: Hızlı Seçim ve Aralık Uygulama -->
                    <Grid Grid.Row="2" IsEnabled="{Binding IsLocked, Converter={StaticResource InverseBoolConverter}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:TextBox x:Name="TxtChapterRange"
                                        Width="148"
                                        PlaceholderText="Aralık: 1-5, 8"
                                        Text="{Binding ChapterRangeText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        KeyDown="TxtChapterRange_KeyDown"/>
                            <ui:Button Content="Aralığı Seç"
                                       Appearance="Secondary"
                                       Margin="6,0,0,0"
                                       Padding="10,5"
                                       Command="{Binding ApplyRangeCommand}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                            <ui:Button Content="Çevrilmemişleri Seç"
                                       Appearance="Transparent"
                                       Padding="9,5"
                                       Command="{Binding SelectUntranslatedCommand}"/>
                            <ui:Button Content="Görünürleri Seç"
                                       Appearance="Transparent"
                                       Padding="9,5"
                                       Margin="4,0,0,0"
                                       Command="{Binding SelectAllVisibleCommand}"/>
                            <ui:Button Content="Seçimi Temizle"
                                       Appearance="Transparent"
                                       Padding="9,5"
                                       Margin="4,0,0,0"
                                       Command="{Binding ClearSelectionCommand}"/>
                        </StackPanel>

                        <TextBlock Grid.Column="3"
                                   Text="{Binding SelectedChaptersSummary}"
                                   VerticalAlignment="Center"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource StudioAccentBrush}"/>
                    </Grid>
                </Grid>
            </Border>

            <!-- 4. Bölüm Listesi Tablosu -->
            <Border Grid.Row="3"
                    Background="{DynamicResource StudioCardBrush}"
                    BorderBrush="{DynamicResource StudioBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                <Grid>
                    <DataGrid ItemsSource="{Binding FilteredChapters}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="{DynamicResource DataGridGridLineBrush}"
                              Background="Transparent"
                              BorderThickness="0"
                              RowHeight="36"
                              AlternatingRowBackground="{DynamicResource DataGridAlternatingRowBrush}"
                              IsEnabled="{Binding IsLocked, Converter={StaticResource InverseBoolConverter}}">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="Seç" Width="50">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn Header="#" Binding="{Binding OrderNumber}" Width="46" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Bölüm Adı" Binding="{Binding DisplayTitle}" Width="2*" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Dosya (Href)" Binding="{Binding Href}" Width="1.5*" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Rol" Binding="{Binding RoleText}" Width="110" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Durum" Binding="{Binding StatusBadge}" Width="120" IsReadOnly="True"/>

                            <DataGridTemplateColumn Header="" Width="44">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ui:Button Icon="{ui:SymbolIcon ArrowReset24}"
                                                   Appearance="Transparent"
                                                   Padding="6,3"
                                                   HorizontalAlignment="Center"
                                                   ToolTip="Bu bölümün checkpoint önbelleğini sıfırla"
                                                   Command="{Binding DataContext.ResetChapterCheckpointCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                   CommandParameter="{Binding}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Filtre Sonucu Boş Mesajı -->
                    <StackPanel HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Visibility="{Binding HasNoFilteredChapters, Converter={StaticResource BoolToVisConverter}}">
                        <ui:SymbolIcon Symbol="Filter24" FontSize="28" Opacity="0.6" HorizontalAlignment="Center"/>
                        <TextBlock Text="Filtreye uygun bölüm bulunamadı."
                                   Margin="0,8,0,0"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
