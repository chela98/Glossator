<UserControl x:Class="Glossator.App.Views.Pages.LibraryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:controls="clr-namespace:Glossator.App.Views.Controls">
    <Grid Margin="24,20,24,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Üst Başlık ve Açma Aksiyonları -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel>
                <TextBlock Text="Kitaplığım" FontSize="22" FontWeight="SemiBold"/>
                <TextBlock Text="{Binding LibrarySummaryText}"
                           FontSize="12.5"
                           Margin="0,3,0,0"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <ui:Button Content="EPUB Dosyası Aç"
                           Icon="{ui:SymbolIcon DocumentAdd24}"
                           Appearance="Primary"
                           Command="{Binding OpenBookFileCommand}"
                           Margin="0,0,8,0"/>
                <ui:Button Content="Klasör Aç"
                           Icon="{ui:SymbolIcon FolderOpen24}"
                           Appearance="Secondary"
                           Command="{Binding OpenFolderCommand}"
                           Margin="0,0,8,0"/>
                <ui:Button ToolTip="Diskte bulunmayan eksik kitap kayıtlarını listeden temizler"
                           Icon="{ui:SymbolIcon Broom24}"
                           Appearance="Secondary"
                           Command="{Binding CleanMissingBooksCommand}"/>
            </StackPanel>
        </Grid>

        <!-- Arama ve Sürükle-Bırak İpucu Şeridi -->
        <Grid Grid.Row="1" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MaxWidth="420"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <ui:TextBox Grid.Column="0"
                        PlaceholderText="Kitap adı, yazar veya yayınevine göre ara..."
                        Icon="{ui:SymbolIcon Search24}"
                        Text="{Binding SearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

            <Border Grid.Column="1"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Background="{DynamicResource StudioCardBrush}"
                    BorderBrush="{DynamicResource StudioBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="10,5">
                <StackPanel Orientation="Horizontal">
                    <ui:SymbolIcon Symbol="ArrowDownload24" FontSize="13" Margin="0,0,6,0"
                                   Foreground="{DynamicResource StudioAccentBrush}"/>
                    <TextBlock Text="İpucu: .epub dosyasını veya OEBPS klasörünü doğrudan pencereye sürükleyip bırakabilirsiniz."
                               FontSize="11.5"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Kitap Kartları Alanı -->
        <ScrollViewer Grid.Row="2"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Visibility="{Binding HasRecentBooks, Converter={StaticResource BoolToVisConverter}}">
            <ItemsControl ItemsSource="{Binding FilteredRecentBooks}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Width="332"
                                Margin="0,0,14,14"
                                Padding="14"
                                Background="{DynamicResource StudioCardBrush}"
                                BorderBrush="{DynamicResource StudioBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="62"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <controls:BookCoverControl Grid.Column="0"
                                                           Width="62" Height="84"
                                                           VerticalAlignment="Top"
                                                           CoverPath="{Binding ValidCoverImagePath}"
                                                           Monogram="{Binding FallbackMonogram}"
                                                           FallbackHex="{Binding FallbackBackgroundHex}"
                                                           CoverCornerRadius="6"
                                                           MonogramFontSize="20"/>

                                <Grid Grid.Column="1" Margin="14,0,0,0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0"
                                               Text="{Binding Title}"
                                               FontSize="14"
                                               FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis"
                                               MaxHeight="38"
                                               TextWrapping="Wrap"
                                               ToolTip="{Binding Title}"/>

                                    <StackPanel Grid.Row="1" Margin="0,3,0,8">
                                        <TextBlock Text="{Binding Author}"
                                                   FontSize="12"
                                                   TextTrimming="CharacterEllipsis"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                        <TextBlock Text="{Binding Publisher}"
                                                   FontSize="11"
                                                   Opacity="0.8"
                                                   TextTrimming="CharacterEllipsis"
                                                   Visibility="{Binding Publisher, Converter={StaticResource HasValueToVisConverter}}"
                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                    </StackPanel>

                                    <StackPanel Grid.Row="2" VerticalAlignment="Bottom" Margin="0,0,0,8">
                                        <Grid Margin="0,0,0,4">
                                            <TextBlock FontSize="11.5" Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                                                <Run Text="{Binding TranslatedChapters, Mode=OneWay}"/>
                                                <Run Text="/"/>
                                                <Run Text="{Binding TotalChapters, Mode=OneWay}"/>
                                                <Run Text="Bölüm"/>
                                            </TextBlock>
                                            <TextBlock HorizontalAlignment="Right"
                                                       FontSize="11.5"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource StudioAccentBrush}"
                                                       Text="{Binding ProgressPercentage, StringFormat='%{0:F1}'}"/>
                                        </Grid>
                                        <ProgressBar Value="{Binding ProgressPercentage, Mode=OneWay}"
                                                     Maximum="100"
                                                     Height="4"/>
                                    </StackPanel>

                                    <Grid Grid.Row="3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <ui:Button Grid.Column="0"
                                                   Content="Masada Aç"
                                                   Icon="{ui:SymbolIcon Open24}"
                                                   Appearance="Secondary"
                                                   Padding="10,5"
                                                   HorizontalAlignment="Stretch"
                                                   Command="{Binding DataContext.OpenBookEntryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                   CommandParameter="{Binding}"/>

                                        <ui:Button Grid.Column="1"
                                                   Margin="6,0,0,0"
                                                   Padding="8,5"
                                                   ToolTip="Klasörü Explorer'da Aç"
                                                   Icon="{ui:SymbolIcon FolderOpen24}"
                                                   Appearance="Transparent"
                                                   Command="{Binding DataContext.OpenBookFolderCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                   CommandParameter="{Binding}"/>

                                        <ui:Button Grid.Column="2"
                                                   Margin="4,0,0,0"
                                                   Padding="8,5"
                                                   ToolTip="Listeden Kaldır (Diskten silinmez)"
                                                   Icon="{ui:SymbolIcon Dismiss24}"
                                                   Appearance="Transparent"
                                                   Command="{Binding DataContext.RemoveBookEntryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                   CommandParameter="{Binding}"/>
                                    </Grid>
                                </Grid>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Boş Durum (İlk Kurulum / Kütüphane Boşsa) -->
        <Border Grid.Row="2"
                Background="{DynamicResource StudioCardBrush}"
                BorderBrush="{DynamicResource StudioBorderBrush}"
                BorderThickness="1"
                CornerRadius="12"
                Padding="36"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                MaxWidth="520"
                Visibility="{Binding HasRecentBooks, Converter={StaticResource InverseBoolToVisConverter}}">
            <StackPanel HorizontalAlignment="Center">
                <ui:SymbolIcon Symbol="Library24" FontSize="42" Foreground="{DynamicResource StudioAccentBrush}" HorizontalAlignment="Center"/>
                <TextBlock Text="Kitaplığınız Henüz Boş"
                           FontSize="17"
                           FontWeight="SemiBold"
                           Margin="0,12,0,6"
                           HorizontalAlignment="Center"/>
                <TextBlock Text="Bir .epub dosyasını veya açılmış EPUB klasörünü buraya sürükleyip bırakın ya da aşağıdaki butonla seçin."
                           FontSize="12.5"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           Margin="0,0,0,18"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <ui:Button Content="EPUB Kitabı Seç"
                               Icon="{ui:SymbolIcon DocumentAdd24}"
                               Appearance="Primary"
                               Command="{Binding OpenBookFileCommand}"
                               Margin="0,0,8,0"/>
                    <ui:Button Content="Klasör Seç"
                               Icon="{ui:SymbolIcon FolderOpen24}"
                               Appearance="Secondary"
                               Command="{Binding OpenFolderCommand}"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
