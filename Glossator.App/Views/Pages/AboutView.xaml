<UserControl x:Class="Glossator.App.Views.Pages.AboutView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Glossator.App.Views.Controls"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="24,18,24,16">
        <StackPanel MaxWidth="920" HorizontalAlignment="Left">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
                <controls:GlossatorLogoControl Width="42"
                                               Height="42"
                                               Margin="0,0,14,0"
                                               VerticalAlignment="Center"/>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Hakkımda" FontSize="22" FontWeight="SemiBold"/>
                    <TextBlock Text="Geliştirici profili, proje mimarisi ve açık kaynak bağlantıları"
                               FontSize="12.5"
                               Margin="0,3,0,0"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                </StackPanel>
            </StackPanel>

            <!-- Öne Çıkarılmış Geliştirici Portfolyo Kartı -->
            <Border Background="{DynamicResource StudioCardBrush}"
                    BorderBrush="{DynamicResource StudioBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="22"
                    Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Avatar Rozeti -->
                    <Border Width="76" Height="76"
                            CornerRadius="38"
                            VerticalAlignment="Top"
                            BorderBrush="#553B82F6"
                            BorderThickness="2">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#2563EB" Offset="0"/>
                                <GradientStop Color="#1E3A8A" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <TextBlock Text="ED"
                                   FontSize="24"
                                   FontWeight="Bold"
                                   Foreground="White"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel Grid.Column="1" Margin="20,0,0,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{Binding DeveloperName}" FontSize="20" FontWeight="SemiBold"/>
                            <Border Background="{DynamicResource StudioAccentSoftBrush}"
                                    BorderBrush="{DynamicResource StudioAccentBrush}"
                                    BorderThickness="1"
                                    CornerRadius="5"
                                    Padding="8,2"
                                    Margin="10,0,0,0"
                                    VerticalAlignment="Center">
                                <TextBlock Text="{Binding DeveloperHandle}"
                                           FontSize="11.5"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource StudioAccentForegroundBrush}"/>
                            </Border>
                        </StackPanel>

                        <TextBlock Text="{Binding RoleSummary}"
                                   FontSize="13"
                                   FontWeight="Medium"
                                   Margin="0,4,0,10"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>

                        <TextBlock Text="{Binding ProjectDescription}"
                                   FontSize="12.5"
                                   TextWrapping="Wrap"
                                   LineHeight="20"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Margin="0,0,0,16"/>

                        <!-- Yalnızca Simgeli Sosyal / Kod Bağlantıları -->
                        <WrapPanel>
                            <Button Style="{StaticResource LinkedInActionButtonStyle}"
                                    Width="42"
                                    Height="36"
                                    Padding="0"
                                    ToolTip="LinkedIn · emre-dalbudak"
                                    Command="{Binding OpenLinkedInCommand}"
                                    Margin="0,0,8,0">
                                <Path Data="{StaticResource LinkedInLogoGeometry}"
                                      Stretch="Uniform"
                                      Width="16"
                                      Height="16"
                                      Fill="White"/>
                            </Button>

                            <Button Style="{StaticResource GitHubActionButtonStyle}"
                                    Width="42"
                                    Height="36"
                                    Padding="0"
                                    ToolTip="GitHub · @chela98"
                                    Command="{Binding OpenGitHubCommand}"
                                    Margin="0,0,8,0">
                                <Path Data="{StaticResource GitHubLogoGeometry}"
                                      Stretch="Uniform"
                                      Width="16"
                                      Height="16"
                                      Fill="#F0F6FC"/>
                            </Button>

                            <ui:Button Appearance="Secondary"
                                       Height="36"
                                       Padding="12,0"
                                       ToolTip="github.com/chela98/Glossator"
                                       Command="{Binding OpenRepoCommand}">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <ui:SymbolIcon Symbol="Code24"
                                                   FontSize="15"
                                                   Margin="0,0,7,0"
                                                   VerticalAlignment="Center"/>
                                    <TextBlock Text="Kaynak Kodu" VerticalAlignment="Center"/>
                                    <ui:SymbolIcon Symbol="Open24"
                                                   FontSize="12"
                                                   Margin="6,0,0,0"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                </StackPanel>
                            </ui:Button>
                        </WrapPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Teknoloji Yığını Rozetleri -->
            <Border Background="{DynamicResource StudioCardBrush}"
                    BorderBrush="{DynamicResource StudioBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="18"
                    Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="Mimari ve Teknoloji Yığını" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,10"/>
                    <ItemsControl ItemsSource="{Binding ArchitectureBadges}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource StudioCardElevatedBrush}"
                                        BorderBrush="{DynamicResource StudioBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Padding="10,5"
                                        Margin="0,0,8,8">
                                    <TextBlock Text="{Binding}" FontSize="12" FontWeight="SemiBold"/>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Çoklu Ajan Akış Özeti -->
            <Border Background="{DynamicResource StudioCardBrush}"
                    BorderBrush="{DynamicResource StudioBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="18">
                <StackPanel>
                    <TextBlock Text="{Binding PipelineTitle}" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,12"/>
                    <ItemsControl ItemsSource="{Binding PipelineStages}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Width="22"
                                            Height="22"
                                            CornerRadius="11"
                                            Margin="0,1,12,0"
                                            VerticalAlignment="Top"
                                            Background="{DynamicResource StudioAccentSoftBrush}"
                                            BorderBrush="{DynamicResource StudioAccentBrush}"
                                            BorderThickness="1">
                                        <TextBlock Text="{Binding StepNumber}"
                                                   FontSize="11.5"
                                                   FontWeight="SemiBold"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource StudioAccentForegroundBrush}"/>
                                    </Border>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding Title}"
                                                   FontSize="12.5"
                                                   FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding Description}"
                                                   FontSize="12"
                                                   LineHeight="18"
                                                   Margin="0,2,0,0"
                                                   TextWrapping="Wrap"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
